---
import Img from './Img.astro';
import type { Lang } from '../content/site';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  text: string;
  cta1Label: string;
  cta1Href: string;
  cta2Label?: string;
  cta2Href?: string;
  image: string;
  alt: string;
  meta?: string[];
}
const { lang, eyebrow, title, text, cta1Label, cta1Href, cta2Label, cta2Href, image, alt, meta = [] } = Astro.props;
const idx = title.lastIndexOf('. ');
const head = idx > 0 ? title.slice(0, idx + 1) : '';
const tail = idx > 0 ? title.slice(idx + 2) : title;
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>';
---
<section class="hero">
  <div class="hero-media">
    <Img name={image} alt={alt} sizes="100vw" priority={true} />
  </div>
  <div class="hero-content">
    <div class="container">
      <div class="hero-inner">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{head}<br /><em>{tail}</em></h1>
        <p class="hero-text">{text}</p>
        <div class="hero-actions">
          <a class="btn btn--gold" href={cta1Href}>{cta1Label} <Fragment set:html={arrow} /></a>
          {cta2Label && cta2Href && (
            <a class="btn btn--ghost" href={cta2Href}>{cta2Label}</a>
          )}
        </div>
        {meta.length > 0 && (
          <div class="hero-meta">
            {meta.map((m) => <span>{m}</span>)}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
