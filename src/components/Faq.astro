---
interface Props {
  title?: string;
  items: { q: string; a: string }[];
  lang: 'fr' | 'en';
}
const { title, items, lang } = Astro.props;
---
<div class="faq">
  {title && <h2 class="sr-only">{title}</h2>}
  {items.map((it, i) => (
    <details open={i === 0}>
      <summary>{it.q}<span class="plus" aria-hidden="true"></span></summary>
      <div class="faq-a"><p>{it.a}</p></div>
    </details>
  ))}
</div>
