---
interface Props { code: 'fr' | 'gb'; size?: number }
const { code, size = 20 } = Astro.props;
const h = Math.round(size * 0.7);
---
{code === 'fr' ? (
  <svg class="flag" width={size} height={h} viewBox="0 0 30 21" aria-hidden="true" focusable="false">
    <rect width="10" height="21" fill="#0B3D91"/>
    <rect x="10" width="10" height="21" fill="#F5F2E9"/>
    <rect x="20" width="10" height="21" fill="#D02B32"/>
  </svg>
) : (
  <svg class="flag" width={size} height={h} viewBox="0 0 30 21" aria-hidden="true" focusable="false">
    <rect width="30" height="21" fill="#0B2E5B"/>
    <path d="M0 0L30 21M30 0L0 21" stroke="#F5F2E9" stroke-width="4.2"/>
    <path d="M0 0L30 21M30 0L0 21" stroke="#C8102E" stroke-width="1.8"/>
    <rect x="11.5" width="7" height="21" fill="#F5F2E9"/>
    <rect y="7" width="30" height="7" fill="#F5F2E9"/>
    <rect x="13" width="4" height="21" fill="#C8102E"/>
    <rect y="8.5" width="30" height="4" fill="#C8102E"/>
  </svg>
)}
