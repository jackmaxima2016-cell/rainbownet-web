---
import Base from '../../layouts/Base.astro';
import { UI, type Lang } from '../../content/site';
import { CREDITS } from '../../content/pages';
import credits from '../../content/image-credits.json';

export function getStaticPaths() { return [{ params: { lang: 'fr' } }, { params: { lang: 'en' } }]; }
const lang = Astro.params.lang as Lang;
const t = UI[lang];
const c = CREDITS[lang];
const L = (p: string) => `/${lang}${p}`;
const items = Object.entries(credits as Record<string, any>);
---
<Base lang={lang} slug="/credits/" title={c.metaTitle} description={c.metaDescription} noindex={true}>
  <section class="section section--ivory" style="padding-top:calc(var(--header-h) + 64px)">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={L('/')}>{t.breadcrumbHome}</a><span aria-hidden="true">/</span><span>{c.title}</span>
      </nav>
      <div class="narrow">
        <p class="eyebrow">{lang === 'fr' ? 'Transparence' : 'Transparency'}</p>
        <h1 style="font-size:clamp(1.9rem,3.6vw,2.8rem)">{c.title}</h1>
        <p class="lead" style="margin:18px 0 34px">{c.intro}</p>
        <ul style="list-style:none;padding:0;margin:0;border-top:1px solid rgba(16,30,44,.12)">
          {items.map(([name, cr]) => (
            <li style="border-bottom:1px solid rgba(16,30,44,.12);padding:14px 0;font-size:.88rem">
              <a href={cr.url} rel="noopener nofollow" target="_blank" style="border-bottom:1px solid var(--gold)">{name}</a>
              <span style="color:var(--muted)"> — © {cr.photographer}, Pexels</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
