# Cloudflare Pages — build & runtime variables
# Copy to `.dev.vars` for local `wrangler pages dev`, and set the same values
# in the Pages project (Settings → Variables and Secrets).

# --- Build-time (public, inlined into the HTML) ---
# Google reCAPTCHA Enterprise site key (public). Set it on the Pages project as a
# plain variable so builds pick it up; empty = integration dormant.
PUBLIC_RECAPTCHA_SITE_KEY=6LdOUwguAAAAABQFBWWzsnb6qNhDauoIhApVHjAE

# --- Runtime (encrypted secrets) ---
# reCAPTCHA Enterprise — token verification goes through the VPS relay
# (captcha.accidata.fr/verify), which holds the Google service account.
RECAPTCHA_SITE_KEY=6LdOUwguAAAAABQFBWWzsnb6qNhDauoIhApVHjAE
RECAPTCHA_MIN_SCORE=0.5

# Email relay — Resend (primary) then cPanel SMTP (fallback)
RESEND_API_KEY=
SENDER_NAME=RAINBOWNET
SENDER_EMAIL=Luc@rainbownet.ch
LEADS_TO=jackmaxima2016@gmail.com

# cPanel SMTP fallback (o2switch)
SMTP_HOST=flocon.o2switch.net
SMTP_PORT=465
SMTP_USER=info@agenceweb4.ch
SMTP_PASS=

# Optional fallback if SMTP and Resend are unavailable
BREVO_API_KEY=
